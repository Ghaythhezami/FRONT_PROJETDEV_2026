# Copy this file to env/.env and adjust values for your environment.
#
#   cp env/.env.example env/.env
#
# Local dev: npm start  (runs generate-env.mjs automatically)
# Vercel: set API_BASE_URL in Project → Settings → Environment Variables

# Backend API (no trailing slash) — your Render service URL
API_BASE_URL=https://your-api.onrender.com

# Role assigned when a user registers via /signup
DEFAULT_SIGNUP_ROLE=analyste

# Web Push VAPID public key (must match backend Vapid:PublicKey)
VAPID_PUBLIC_KEY=BDFMs4p98XwAYjQfXPVBooBx_T_1zN5voNnRY7yo-Tk3u15eMe3ToIJ9g2dZgUolZpWJmNf1HsJYSKjOIfqUu_8
