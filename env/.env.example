# Copy this file to env/.env and adjust values for your environment.
#
#   cp env/.env.example env/.env
#
# Then run: npm start
# (generates src/environments/environment.ts automatically)

# Backend API — deployed Swagger: https://projetdev2026.onrender.com/swagger/index.html
API_BASE_URL=https://projetdev2026.onrender.com

# Role assigned when a user registers via /signup (backend RegisterUserDto.Role)
# Allowed values: admin | agent de controle | analyste
DEFAULT_SIGNUP_ROLE=analyste
